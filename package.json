{
  "name": "favsync",
  "version": "0.1.0",
  "description": "把抖音、微博、X 的收藏/点赞/书签自动同步到本地并存档（文本 + 原图 + 视频），站点挂了也不丢 | Self-hosted archiver for your Douyin / Weibo / X favorites",
  "type": "module",
  "license": "MIT",
  "author": "CorCvusRamboChen",
  "repository": {
    "type": "git",
    "url": "https://github.com/CorCvusRamboChen/favsync.git"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.mjs",
    "login:douyin": "node scripts/douyin-login-qr.mjs",
    "login:x": "node scripts/login-x.mjs",
    "shot": "node scripts/shot-local.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.62.1"
  }
}
